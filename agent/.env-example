export SYMON_SERVER_ID=unique_name
export SYMON_MONITOR_INTERVAL_SECONDS=30
export SYMON_COLLECTOR_ENDPOINT=localhost:9000
export SYMON_COLLECTOR_ENDPOINT_CERT_PATH=
export SYMON_AGENT_LOG_FILE_ENABLED=false
export SYMON_AGENT_LOG_FILE_PATH=
export SYMON_DISKS_TO_IGNORE="/dev/loop0,/dev/loop1,/dev/loop2,/dev/loop3"
export SYMON_SERVICE_LIST_PATH="services.json"
# commands admins may start from the dashboard, see tasks.json. No file, no tasks.
# It must belong to root or the agent's user and not be writable by others.
export SYMON_TASKS_PATH=/etc/symon/tasks.json
# optional collectors to switch off: diskio, tcp, pressure, temps, containers
export SYMON_DISABLED_COLLECTORS=
# report the agent's own cgroup limits instead of the host's
export SYMON_CONTAINER_AWARE=false
# Docker compatible socket for container names, Podman uses /run/podman/podman.sock
export SYMON_CONTAINER_SOCKET=
# measure each container's writable layer, walks every file in it
export SYMON_CONTAINER_LAYER_SIZE=false
# CRI socket that names Kubernetes pod containers, empty means
# /run/containerd/containerd.sock, CRI-O is /var/run/crio/crio.sock
export SYMON_CRI_SOCKET=
# read a Kubernetes cluster's API and report it, on one node per cluster.
# The API URL is the server: line of /etc/kubernetes/admin.conf, the token
# comes from docs/kubernetes/symon-reader.yaml.
export SYMON_KUBE_CLUSTER=
export SYMON_KUBE_API_URL=
export SYMON_KUBE_CA_PATH=/etc/kubernetes/pki/ca.crt
export SYMON_KUBE_TOKEN_PATH=/etc/symon/kube.token
# poll switches, UPSs and other boxes over SNMP, see snmp.json. No file, no
# devices. The file holds community strings, so it must be mode 600 and
# belong to root or the agent's user.
export SYMON_SNMP_DEVICES_PATH=/etc/symon/snmp.json
export SYMON_SNMP_INTERVAL_SECONDS=60
export SYMON_KEY=''
