export SYMON_CLIENT_PORT=8080
export SYMON_CLIENT_COLLECTOR_ENDPOINT=
export SYMON_CLIENT_COLLECTOR_ENDPOINT_CA_CERT_PATH=
# how often the dashboard reloads live data
export SYMON_CLIENT_REFRESH_SECONDS=15
# agent builds new hosts download, relative to the working directory
export SYMON_CLIENT_DOWNLOADS_DIR=downloads
# how agents on other hosts reach the collector, when the dashboard's host
# name with the collector's port does not work
export SYMON_CLIENT_AGENT_COLLECTOR_ENDPOINT=
# /metrics for Prometheus, on unless this is false
export SYMON_CLIENT_METRICS_ENABLED=
# true makes /metrics need a SyMon user, as HTTP basic auth for Prometheus
export SYMON_CLIENT_METRICS_AUTH=
export SYMON_CLIENT_LOG_FILE_ENABLED=
export SYMON_CLIENT_LOG_FILE_PATH=
export SYMON_KEY=''
