# SyMon Alert processor, reads settings from /etc/symon/alertprocessor.env.
# Expects the release bundle extracted to /opt/symon, see README.MD.
[Unit]
Description=SyMon Alert processor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=symon
Group=symon
EnvironmentFile=/etc/symon/alertprocessor.env
WorkingDirectory=/opt/symon/alertprocessor_linux_x86_64
ExecStart=/opt/symon/alertprocessor_linux_x86_64/alertprocessor_linux_x86_64
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
